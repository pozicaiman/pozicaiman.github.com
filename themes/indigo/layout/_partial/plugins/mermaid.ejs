<% if (theme.mermaid){ %>
<script>
// 把正文里的 mermaid 代码块还原成可被 mermaid 解析的 <pre class="mermaid">。
// 背景：Hexo 的 highlight.js 会把未知语言 mermaid 当作 plaintext 输出，围栏语言标记在
// 构建产物里被丢弃，因此不能只靠 class 判断，需再按"首行是否为 mermaid 图类型关键字"识别。
// 兼容三种产物：<pre><code class="language-mermaid">、<figure class="highlight ...">、<pre class="mermaid">。
(function () {
    // mermaid 各类图的起始关键字（首行匹配即判定为 mermaid 源码）
    var KEYWORD = /^\s*(flowchart|graph|sequenceDiagram|classDiagram|stateDiagram(?:-v2)?|erDiagram|gantt|pie|journey|mindmap|timeline|quadrantChart|requirementDiagram|gitGraph|packet|block-beta|C4Context|Sankey|xychart-beta|architecture)/;

    function extractSource(block) {
        // line_number 开启时 figure 内含 gutter(行号) 与 code(正文) 两个单元格，
        // 只在 .code 单元格内取行，避免把行号拼进源码
        var codeCell = block.querySelector ? block.querySelector('.code') : null;
        var scope = codeCell || block;
        var lines = scope.querySelectorAll('span.line');
        if (lines.length) {
            var arr = [];
            for (var i = 0; i < lines.length; i++) arr.push(lines[i].textContent);
            return arr.join('\n');
        }
        var code = scope.querySelector('code');
        return (code || scope).textContent;
    }

    function looksLikeMermaid(node, src) {
        var cls = ' ' + (node.className || '') + ' ';
        if (/ (mermaid|language-mermaid) /.test(cls)) return true;   // 显式标记（若构建保留）
        return KEYWORD.test(src);                                     // 按内容首行判定
    }

    function normalize() {
        var nodes = document.querySelectorAll('code, figure.highlight, pre');
        for (var i = 0; i < nodes.length; i++) {
            var node = nodes[i];
            if (!node.isConnected) continue;                    // 已被替换，跳过
            if (node.dataset && node.dataset.mermaidRaw) continue; // 已处理产物

            // 定位要被整体替换的最外层块
            var block;
            if (node.tagName === 'CODE') block = node.parentNode;   // <pre>
            else if (node.tagName === 'FIGURE') block = node;       // figure.highlight
            else block = node;                                      // 已是 <pre>

            var src = extractSource(block);
            if (!looksLikeMermaid(block, src) && !looksLikeMermaid(node, src)) continue;

            var holder = document.createElement('pre');
            holder.className = 'mermaid';
            holder.dataset.mermaidRaw = '1';
            holder.textContent = src;
            if (block.parentNode) block.parentNode.replaceChild(holder, block);
        }
    }

    function ready(fn) {
        if (document.readyState !== 'loading') fn();
        else document.addEventListener('DOMContentLoaded', fn);
    }
    ready(normalize);
    window.__mermaidNormalize = normalize;
})();
</script>
<script type="module">
    try {
        const mermaid = (await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs')).default;
        mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'loose', fontFamily: 'inherit' });
        window.__mermaidNormalize && window.__mermaidNormalize();
        await mermaid.run({ querySelector: '.mermaid' });
    } catch (e) {
        // 加载失败（离线/网络受限）时保留原始文本，GitHub 源码视图仍可原生渲染
        console.warn('[mermaid] 渲染跳过，保留源码文本：', e);
    }
</script>
<% } %>
